# Optional. Without this key the app plays a labeled recorded round.
# It never pretends that round is live Grok.
XAI_API_KEY=

# Optional. Defaults to grok-4.6
XAI_MODEL=grok-4.6

# Optional. Unused in this demo — Harbor & Co. is a simulated catalog
# until a real Admin API token is available.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
