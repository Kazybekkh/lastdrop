# grok-bot (default), xai, or replay. Grok Bot uses the installed skill CLI
# and the desktop app's existing sign-in on the machine running Next.js.
GROK_PROVIDER=grok-bot

# Optional if installed in ~/.agents, ~/.codex, ~/.cursor, or ~/.claude/skills.
GROK_BOT_SCRIPT=
GROK_BOT_PYTHON=python3

# Defaults to existing bots named Nell, Mara, Len, and Ida.
# Set a shared bot name (or GROK_BOT_ID) to play all four roles with one bot.
GROK_BOT_NAME=
GROK_BOT_ID=
# Optional role-specific selectors override the shared selector.
GROK_BOT_MERCHANT_NAME=
GROK_BOT_DENIM_NAME=
GROK_BOT_BARGAIN_NAME=
GROK_BOT_PREMIUM_NAME=
# GROK_BOT_MERCHANT_ID, GROK_BOT_DENIM_ID, GROK_BOT_BARGAIN_ID,
# and GROK_BOT_PREMIUM_ID take precedence over names.

# Only needed when GROK_PROVIDER=xai. Grok Bot does not use an xAI API key.
XAI_API_KEY=

# Optional. Defaults to grok-4.6
XAI_MODEL=grok-4.6

# Optional. Unused in this demo — Harbor & Co. is a simulated catalog
# until a real Admin API token is available.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
